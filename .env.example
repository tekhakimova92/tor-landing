# Бот, который присылает заявки на бронь
TELEGRAM_BOT_TOKEN=
# Чат, куда приходят заявки (id пользователя или группы)
TELEGRAM_CHAT_ID=
# Supabase: заявки сохраняются в таблицу bookings (supabase/migrations)
SUPABASE_URL=
# Секретный ключ, только для сервера — не публиковать
SUPABASE_SECRET_KEY=
# Секрет вебхука бота: любая случайная строка (openssl rand -hex 24)
TELEGRAM_WEBHOOK_SECRET=
